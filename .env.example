# Modelo de configuração por ambiente do SIGAB/Conecta 360.
# Copie para ".env" (nunca versionado) e ajuste os valores reais.
# Nenhuma variável aqui tem valor real — todos são exemplos fictícios.
#
# Se nenhum .env existir, o sistema roda em modo LOCAL com SQLite, exatamente
# como sempre funcionou — nenhuma dessas variáveis é obrigatória para isso.

# local | homologacao | producao
AMBIENTE=local

# LOCAL (padrão quando ausente — nem precisa declarar):
# DATABASE_URL=sqlite:///./database/sigab.db
#
# HOMOLOGACAO / PRODUCAO (PostgreSQL gerenciado, ex.: Neon):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=

# Chave usada para assinar cookies de sessão (gerar uma própria por ambiente,
# nunca reaproveitar entre homologação e produção). Exemplo de geração:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-antes-de-qualquer-ambiente-fora-do-local

DEBUG=true
HOST=127.0.0.1
PORT=8000

# Tempo de vida da sessão de login, em horas.
SESSAO_MAX_IDADE_HORAS=12

# Origens externas liberadas para CORS, separadas por vírgula. Vazio (padrão)
# é o correto para o SIGAB hoje: app renderizado no servidor, sem frontend
# separado de outra origem consumindo API.
CORS_ORIGINS=

LOG_LEVEL=INFO
