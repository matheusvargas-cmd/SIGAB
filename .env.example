# Modelo de configuração por ambiente do SIGAB/Conecta 360.
# Copie para ".env" (nunca versionado) e ajuste os valores reais.
# Nenhuma variável aqui tem valor real — todos são exemplos fictícios.
#
# Se nenhum .env existir, o sistema roda em modo LOCAL com SQLite, exatamente
# como sempre funcionou — nenhuma dessas variáveis é obrigatória para isso.

# local | homologacao | producao
AMBIENTE=local

# LOCAL (padrão quando ausente — nem precisa declarar):
# DATABASE_URL=sqlite:///./database/sigab.db
#
# HOMOLOGACAO / PRODUCAO (PostgreSQL gerenciado, ex.: Neon):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=

# Chave usada para assinar cookies de sessão (gerar uma própria por ambiente,
# nunca reaproveitar entre homologação e produção). Exemplo de geração:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-antes-de-qualquer-ambiente-fora-do-local

DEBUG=true
HOST=127.0.0.1
PORT=8000

# Tempo de vida da sessão de login, em horas.
SESSAO_MAX_IDADE_HORAS=12

# Origens externas liberadas para CORS, separadas por vírgula. Vazio (padrão)
# é o correto para o SIGAB hoje: app renderizado no servidor, sem frontend
# separado de outra origem consumindo API.
CORS_ORIGINS=

LOG_LEVEL=INFO

# E-mail diário do gabinete (app/services/daily_email_service.py). Sem
# SMTP_HOST/SMTP_FROM definidos, o envio simplesmente não roda — não é
# obrigatório para o resto do sistema funcionar. Nenhum provedor é
# assumido: qualquer SMTP compatível serve (Gmail com senha de app,
# SendGrid, Mailgun, SES etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Token secreto para POST /jobs/enviar-diario (chamado por um agendador
# externo às 07:30 America/Sao_Paulo — não por um usuário logado). Sem
# este valor, a rota fica sempre fechada (503). Gerar com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBS_TOKEN=

# Upload de fotos no atendimento público (Cloudflare R2, S3-compatível —
# ver app/services/storage_service.py). Sem as 5 variáveis abaixo, o
# upload de fotos fica indisponível (mensagem amigável ao cidadão); o
# resto do formulário público continua funcionando normalmente, já que as
# fotos são sempre opcionais. R2_BUCKET_NAME deve ser o bucket privado
# dedicado a este sistema (Public Access = Disabled). R2_ENDPOINT é o
# endpoint S3 da conta Cloudflare:
# https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
